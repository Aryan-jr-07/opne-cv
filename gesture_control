
import cv2
from cvzone.HandTrackingModule import HandDetector
import pyautogui

detector = HandDetector(detectionCon=0.5, maxHands=2)
cap = cv2.VideoCapture(0)
cap.set(3, 600)
cap.set(4, 400)

activeKeys = set()

while True:
    success, img = cap.read()
    img = cv2.flip(img, 1)
    hands, img = detector.findHands(img)
    if hands and hands[0]["type"] == "Left":
        fingers = detector.fingersUp(hands[0])
        totalFingers = fingers.count(1)
        cv2.putText(img, f'Fingers: {totalFingers}', (50, 50), cv2.FONT_HERSHEY_PLAIN, 2, (0, 255, 0), 2)

        # work of keys
        newKeys = set()
        if totalFingers == 1:
            newKeys.add("s")
        elif totalFingers == 2:
            newKeys.add("w")
        elif totalFingers == 3:
            newKeys.update(["w", "a"])  # forward + left
        elif totalFingers == 4:
            newKeys.update(["w", "d"])  # forward + right
        elif totalFingers == 5:
            newKeys.update(["s", "a"])  # backward + left
        elif totalFingers == 6:
            newKeys.update(["s", "d"])  # backward + right

        # Update key states
        for key in activeKeys - newKeys:
            pyautogui.keyUp(key)
        for key in newKeys - activeKeys:
            pyautogui.keyDown(key)

        activeKeys = newKeys

        # for space key
        if fingers == [0, 0, 0, 0, 0]:
            pyautogui.press("space")

    cv2.imshow('Camera Feed', img)
    cv2.waitKey(1)

    

