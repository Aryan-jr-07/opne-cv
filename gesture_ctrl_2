
import cv2
import mediapipe as mp
import pyautogui
import math

# Initialize MediaPipe and OpenCV
mp_hands = mp.solutions.hands
hands = mp_hands.Hands(
    max_num_hands=1,
    min_detection_confidence=0.7,
    min_tracking_confidence=0.5
)
mp_draw = mp.solutions.drawing_utils

# Capture from webcam
cap = cv2.VideoCapture(0)
cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)

# Function to calculate Euclidean distance
def distance(p1, p2):
    return math.sqrt((p1.x - p2.x) ** 2 + (p1.y - p2.y) ** 2)

frame_count = 0
last_keys = set()

def press_keys(new_keys):
    global last_keys
    for key in last_keys - new_keys:
        pyautogui.keyUp(key)
    for key in new_keys - last_keys:
        pyautogui.keyDown(key)
    last_keys = new_keys

while True:
    frame_count += 1
    if frame_count % 2 != 0:
        continue
    success, img = cap.read()
    if not success:
        break

    img_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
    result = hands.process(img_rgb)

    # If hand is detected
    if result.multi_hand_landmarks:
        for hand_landmarks in result.multi_hand_landmarks:
            # Get palm landmarks
            wrist = hand_landmarks.landmark[0]
            index_mcp = hand_landmarks.landmark[5]
            pinky_mcp = hand_landmarks.landmark[17]
            middle_tip = hand_landmarks.landmark[12]

            # Palm center point (between index_mcp and pinky_mcp)
            center_x = (index_mcp.x + pinky_mcp.x) / 2
            center_y = (index_mcp.y + pinky_mcp.y) / 2
            palm_center = type('Point', (object,), {'x': center_x, 'y': center_y})()

            # Palm openness (used to determine if fist is closed)
            openness = distance(palm_center, middle_tip)

            # Detect number of fingers up
            finger_tips = [8, 12, 16, 20]
            finger_pips = [6, 10, 14, 18]
            fingers_up = 0

            for tip, pip in zip(finger_tips, finger_pips):
                if hand_landmarks.landmark[tip].y < hand_landmarks.landmark[pip].y:
                    fingers_up += 1

            if fingers_up == 2:
                press_keys({'space'})
            elif openness > 0.08:  # Threshold to determine open palm
                if index_mcp.y < pinky_mcp.y - 0.03:  # Tilted right → W + D
                    press_keys({'w', 'd'})
                elif pinky_mcp.y < index_mcp.y - 0.03:  # Tilted left → W + A
                    press_keys({'w', 'a'})
                else:  # Palm straight → W
                    press_keys({'w'})
            else:
                press_keys({'s'})

            # Draw landmarks on the hand
            mp_draw.draw_landmarks(img, hand_landmarks, mp_hands.HAND_CONNECTIONS)

    else:
        # If no hand detected, release all keys
        press_keys(set())

    cv2.imshow("Palm Control", img)
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

# Clean up
cap.release()
cv2.destroyAllWindows()
